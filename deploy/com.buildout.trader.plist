<?xml version="1.0" encoding="UTF-8"?>
<!-- Buildout's trader on a Mac, one pass every 15 minutes on weekdays (launchd). The window in the mandate decides
     when a pass may act, so the extra passes cost nothing. Install:
       cp deploy/com.buildout.trader.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.buildout.trader.plist
     Edit the two paths first. Stop everything with: python -m buildout trade halt -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.buildout.trader</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/env</string><string>python3</string><string>-m</string><string>buildout</string><string>trader</string><string>--once</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/you/Documents/buildout</string>
  <key>StartCalendarInterval</key><array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/you/Documents/buildout/private/trader/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/you/Documents/buildout/private/trader/launchd.err</string>
</dict></plist>
